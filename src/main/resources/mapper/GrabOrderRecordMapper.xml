<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.example.mapper.GrabOrderRecordMapper">

    <insert id="insert" parameterType="org.example.entity.GrabOrderRecord"
            useGeneratedKeys="true" keyProperty="id">
        insert into grab_order_record(order_id, worker_id, grab_result, create_time)
        values (#{orderId}, #{workerId}, #{grabResult}, #{createTime})
    </insert>

</mapper>
